# LLM: set OPENROUTER_API_KEY (used first if set) or ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Any OpenRouter model id with tool support. Empty = free models nvidia/nemotron-3-ultra-550b-a55b:free and nvidia/nemotron-3.5-lightning:free.
MODEL_EXTRACT=
MODEL_FAST=

# Required for live generation (search + scrape).
FIRECRAWL_API_KEY=

# Neon postgres URL (sslmode=require). Empty = embedded Postgres in .data/
DATABASE_URL=

RATE_LIMIT_PER_HOUR=5
CACHE_TTL_DAYS=30
DAILY_BUDGET_USD=15
PUBLIC_BASE_URL=http://localhost:3000
# 1 = canned search/LLM, no keys needed (stress test)
MOCK_PIPELINE=
